{
  "manifest_version": 3,
  "name": "Parrot",
  "description": "Turn any LeetCode question into a mock technical interview",
  "version": "0.2.0",
  "icons": {
    "48": "/icons/parrot_logo.png",
    "128": "/icons/parrot_logo.png",
    "256": "/icons/parrot_logo.png"
  },
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "http://localhost/*"
  ],
  "action": {
    "default_icon": {
      "48": "/icons/parrot_logo.png",
      "128": "/icons/parrot_logo.png",
      "256": "/icons/parrot_logo.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "resources": [
        "icons/parrot_logo.png",
        "icons/parrot_logo_back.png"
      ]
    },
    {
      "resources": [
        "content-scripts/content.css"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  },
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting"
  ]
}