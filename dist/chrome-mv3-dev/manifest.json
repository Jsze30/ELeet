  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://harmless-filly-97.clerk.accounts.dev/*/*",
    "http://localhost/*",
    "http://localhost:8080/*",
    "https://accounts.eleetcoder.com/*"
  ],
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_icon": {
      "48": "/icons/ELeet_logo.png",
      "128": "/icons/ELeet_logo.png",
      "256": "/icons/ELeet_logo.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "resources": [
        "/icons/ELeet_logo.png",
        "/icons/ELeet_logo_no_back.png"
      ]
    },
    {
      "resources": [
        "content-scripts/content.css"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  },
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}